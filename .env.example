# Local overrides for docker compose. Copy to .env; nothing here is read by the
# application directly — the app is configured through the environment
# variables in compose.yaml.
KANSO_PORT=8090
MYSQL_PORT=13316
MINIO_PORT=19010
MINIO_CONSOLE_PORT=19011

# Leave both unset for the development default (admin / admin); set them to
# seed real credentials on the first boot instead. Required when APP_ENV=prod.
# KANSO_ADMIN_EMAIL=
# KANSO_ADMIN_PASSWORD=

# Code of the location orders reserve and ship from when they name none.
# Leave unset when the installation has a single location.
# KANSO_DEFAULT_LOCATION=WH1

# JWT signing keypair, base64-encoded PEM. `make keys` generates one; in a real
# installation the operator supplies these as environment variables and never
# stores them in the repository.
# JWT_SECRET_KEY=
# JWT_PUBLIC_KEY=

# Behind a TLS terminator (a load balancer, Caddy, Traefik, a CDN): the
# addresses it connects to the proxy from, as addresses or CIDR ranges,
# comma-separated, or PRIVATE_SUBNETS. Only these may tell the proxy the
# client's address and scheme (X-Forwarded-For, X-Forwarded-Proto). Leave
# unset when browsers reach the proxy directly. README.md, "TLS and the proxy".
# PROXY_TRUSTED_PROXIES=10.0.0.5

# Who the API believes about the client's address and scheme: the proxy.
# The default covers any address Docker gives it; change it only if the API
# is reached through another proxy at a public address.
# TRUSTED_PROXIES=PRIVATE_SUBNETS

# Tracing: empty is off. With `docker compose --profile observability up -d`,
# point it at the local collector (observability/README.md).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# GRAFANA_PORT=13010
# PROMETHEUS_PORT=19091
# JAEGER_PORT=16696
