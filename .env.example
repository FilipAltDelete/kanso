# Local overrides for docker compose. Copy to .env; nothing here is read by the
# application directly — the app is configured through the environment
# variables in compose.yaml.
KANSO_PORT=8090
MYSQL_PORT=13316
MINIO_PORT=19010
MINIO_CONSOLE_PORT=19011

# Leave both unset for the development default (admin / admin); set them to
# seed real credentials on the first boot instead. Required when APP_ENV=prod.
# KANSO_ADMIN_EMAIL=
# KANSO_ADMIN_PASSWORD=

# JWT signing keypair, base64-encoded PEM. `make keys` generates one; in a real
# installation the operator supplies these as environment variables and never
# stores them in the repository.
# JWT_SECRET_KEY=
# JWT_PUBLIC_KEY=
