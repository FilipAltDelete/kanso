{
    "name": "kanso/contracts",
    "description": "The public API of Kanso: the interfaces, DTOs and events customer extensions are written against.",
    "type": "library",
    "license": "proprietary",
    "version": "0.1.0",
    "require": {
        "php": ">=8.4"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Kanso\\Contracts\\": ""
        },
        "exclude-from-classmap": [
            "/composer.json"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
