{
    "name": "kanso/core",
    "description": "Kanso OMS core — web-based order management, one installation per customer.",
    "type": "library",
    "license": "proprietary",
    "version": "0.1.0",
    "repositories": {
        "kanso-contracts": {
            "type": "path",
            "url": "contracts",
            "options": {
                "symlink": true
            }
        }
    },
    "require": {
        "php": ">=8.4",
        "ext-ctype": "*",
        "ext-intl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-pdo_mysql": "*",
        "ext-redis": "*",
        "ext-sodium": "*",
        "api-platform/core": "^4.1",
        "doctrine/dbal": "^4.2",
        "doctrine/doctrine-bundle": "^2.13",
        "doctrine/doctrine-migrations-bundle": "^3.4",
        "doctrine/orm": "^3.5",
        "kanso/contracts": "^0.1",
        "lexik/jwt-authentication-bundle": "^3.1",
        "nyholm/psr7": "^1.8",
        "open-telemetry/exporter-otlp": "^1.0",
        "open-telemetry/sdk": "^1.0",
        "promphp/prometheus_client_php": "^2.14",
        "symfony/clock": "^7.4",
        "symfony/console": "^7.4",
        "symfony/doctrine-messenger": "^7.4",
        "symfony/dotenv": "^7.4",
        "symfony/framework-bundle": "^7.4",
        "symfony/http-client": "^7.4",
        "symfony/lock": "^7.4",
        "symfony/messenger": "^7.4",
        "symfony/monolog-bundle": "^3.10",
        "symfony/property-access": "^7.4",
        "symfony/property-info": "^7.4",
        "symfony/rate-limiter": "^7.4",
        "symfony/security-bundle": "^7.4",
        "symfony/serializer": "^7.4",
        "symfony/uid": "^7.4",
        "symfony/validator": "^7.4",
        "symfony/yaml": "^7.4"
    },
    "require-dev": {
        "dama/doctrine-test-bundle": "^8.2",
        "deptrac/deptrac": "^3.0",
        "friendsofphp/php-cs-fixer": "^3.64",
        "phpstan/extension-installer": "^1.4",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-doctrine": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpstan/phpstan-symfony": "^2.0",
        "phpunit/phpunit": "^11.5",
        "symfony/browser-kit": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Kanso\\Core\\": "src/",
            "Kanso\\Core\\Internal\\": "src/",
            "Kanso\\Core\\Migrations\\": "migrations/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Kanso\\Core\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "php-http/discovery": false,
            "tbachert/spi": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
