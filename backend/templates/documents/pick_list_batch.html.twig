{# Several orders' pick lists in one PDF, each order starting on a new page. #}
{% extends 'base.html.twig' %}

{% block title %}{{ labels.pick_lists }}{% endblock %}

{% block footer %}{{ labels.pick_lists }} · {{ orders|length }} {{ orders|length == 1 ? labels.order|lower : labels.orders }}{% endblock %}

{% block body %}
    {% for entry in orders %}
        <div class="order"{% if not loop.first %} style="page-break-before: always;"{% endif %}>
            {% include '_pick_list.html.twig' with entry|merge({batch: true}) %}
        </div>
    {% endfor %}
{% endblock %}
