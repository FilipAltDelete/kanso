# Everything an installation needs. Copy to .env and fill in; in a deployment
# these arrive as environment variables instead.
APP_ENV=prod
APP_DEBUG=0
APP_SECRET=

DATABASE_URL="mysql://kanso:kanso@mysql:3306/kanso?serverVersion=8.4.0&charset=utf8mb4"
REDIS_URL="redis://redis:6379"
MESSENGER_TRANSPORT_DSN="doctrine://default"

S3_ENDPOINT="http://minio:9000"
S3_PUBLIC_ENDPOINT="http://localhost:19010"
S3_BUCKET=kanso
S3_KEY=
S3_SECRET=

# Base64-encoded PEM keypair; `bin/console kanso:jwt:generate-keys` prints one.
JWT_SECRET_KEY=
JWT_PUBLIC_KEY=

KANSO_ADMIN_EMAIL=
KANSO_ADMIN_PASSWORD=
